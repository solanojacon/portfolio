# Local development settings. Copy this file to .env and adjust as needed:
#   cp .env.example .env
# In production, set these as real environment variables instead.

# Never true in production.
DJANGO_DEBUG=true

# Required when DJANGO_DEBUG is false. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Comma-separated host names the site is served from.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to submit forms, e.g. https://tasks.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Without DATABASE_URL the app uses a local SQLite file (db.sqlite3).
# DATABASE_URL=postgres://user:password@host:5432/dbname

DJANGO_TIME_ZONE=UTC
